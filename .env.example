# Copy this file to .env locally and fill in values from your existing Supabase project.
# Never put service-role keys, database passwords, or other privileged secrets in VITE_* variables.
SUPABASE_PROJECT_ID=your-project-id
SUPABASE_PUBLISHABLE_KEY=your-public-publishable-key
SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_PUBLISHABLE_KEY=your-public-publishable-key
VITE_SUPABASE_URL=https://your-project-id.supabase.co
