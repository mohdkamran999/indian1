# Copy these values into your local .env and Hostinger build environment.
# The URL and project ID are confirmed for the existing IHS Supabase project.
# Replace the placeholder publishable key with the real public key from Supabase API Keys settings.
# Never put service-role keys, database passwords, or other privileged secrets in VITE_* variables.
SUPABASE_PROJECT_ID=uscsoscckihhlmiwzqny
SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_REAL_SUPABASE_PUBLISHABLE_KEY
SUPABASE_URL=https://uscsoscckihhlmiwzqny.supabase.co
VITE_SUPABASE_PROJECT_ID=uscsoscckihhlmiwzqny
VITE_SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_REAL_SUPABASE_PUBLISHABLE_KEY
VITE_SUPABASE_URL=https://uscsoscckihhlmiwzqny.supabase.co

# Optional Meta / Google verification (values copied from your business accounts)
VITE_META_PIXEL_ID=
VITE_META_DOMAIN_VERIFICATION=
VITE_GOOGLE_SITE_VERIFICATION=
