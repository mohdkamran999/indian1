# Copy these names into Hostinger Environment Variables.
# Fill values from your own service dashboards. Never commit real secrets to GitHub.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
HOSTINGER=1
NITRO_PRESET=node-server

# Optional integrations: add only if you actually use them.
# SUPABASE_SERVICE_ROLE_KEY=     # server-only secret; never use a VITE_ prefix
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# SHIPROCKET_EMAIL=
# SHIPROCKET_PASSWORD=
# DELHIVERY_API_TOKEN=
# LOVABLE_API_KEY=
